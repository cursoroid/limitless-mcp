# Claude, used by the agent container
ANTHROPIC_API_KEY=sk-ant-...

# Shared secret: agent sends it as X-API-Key, mcp server checks it
LIMITLESS_API_KEY=change-me

# Postgres
POSTGRES_USER=limitless
POSTGRES_PASSWORD=limitless
POSTGRES_DB=erp
DATABASE_URL=postgresql://limitless:limitless@db:5432/erp

# Agent -> MCP server
MCP_URL=http://mcp:8000/mcp
